%2B%2522day%2522%253A%2B%255B%252210%2522%255D%252C%2B%2522download_format%2522%253A%2B%2522zip%2522%252C%2B%2522format%2522%253A%2B%2522grib%2522%252C%2B%2522month%2522%253A%2B%255B%252206%2522%255D%252C%2B%2522product_type%2522%253A%2B%2522reanalysis%2522%252C%2B%2522time%2522%253A%2B%252212%253A00%2522%252C%2B%2522variable%2522%253A%2B%25222m_temperature%2522%252C%2B%2522year%2522%253A%2B%255B%25222020%2522%255D%257D\n"}],"visibility":"show","key":"Xr5trrRcKI"}],"visibility":"show","key":"SEM9oqvtKu"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"If the data is already available in the cache we can directly download it.\nIf the data is not available, we can see that our request is in ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HiwY3bu0H2"},{"type":"inlineCode","value":"queued","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a4dzRWNF1J"},{"type":"text","value":"status.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SXrKT6qZEf"},{"type":"break","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DAJGbBvowS"},{"type":"text","value":"We will then poll the API until the data is ready and then download it.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ECl8nWowaC"}],"key":"D8VvMghHiA"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Please note that the basic HDA quota allows a maximum of 4 requests per second. The following code limits polling to this quota.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ZZaiWM1NRM"}],"key":"Wtd80Jh14N"}],"key":"zje12uO6tn"}],"key":"FBGXkj7GW