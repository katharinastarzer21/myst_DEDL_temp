xt","value":"The collection used for this tutorial is ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vZoXuQjY2n"},{"type":"link","url":"https://hda.data.destination-earth.eu/ui/dataset/EO.EUM.DAT.SENTINEL-3.OL_2_WRR___","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"OLCI Level 2 Ocean Colour Reduced Resolution - Sentinel-3","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RlR9WIsNJ8"}],"urlSource":"https://hda.data.destination-earth.eu/ui/dataset/EO.EUM.DAT.SENTINEL-3.OL_2_WRR___","key":"DQMoQfsvtB"}],"key":"k0IX5YdZb8"}],"key":"MwvXUCZwcn"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"BODY = {\n    \"collections\": [\n        COLLECTION_ID,\n    ],\n    \"datetime\" : \"2024-09-08T00:00:00Z/2024-09-09T23:59:59Z\",\n    \"bbox\": [-11,35,\n              50,72 ],\n    \"sortby\": [{\"field\": \"datetime\",\"direction\": \"desc\"}\n              ],\n    \"limit\": 3,\n}\n\nr=requests.post(SEARCH_URL, json=BODY, headers=auth_headers)\nif(r.status_code!= 200):\n    (print(r.text))\nr.raise_for_status()\nJSON(r.json(), expanded=False)   ","visibility":"show","key":"ex7CHZv9zg"},{"type":"output","id":"eBgKhOw5K-ytk9ZY7Xn5D","data":[{"output_type":"execute_result","execution_count":6,"metadata":{"application/json":{"expanded":false,"root":"root"}},"data":{"application/json":{"content_type":"application/json","hash":"2ef6edcbcce6b41a9a1875f9ae41f2e8","path":"/2ef6edcbcce6b41a9a1875f9ae41f2e8.json"},"text/plain":{"content":"<IPython.core.display.JSON object>","content_type":"text/plain"}}}],"visibility":"show","key":"euimn5aU7U"}],"visibility":"show","key":"bef2nCXFH3"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Download","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BrWQ1gzHEI"}],"identifier":"download","label":"Download","html_id":"download","implicit":true,"key":"wJTJnwZkHt"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Once obtained the search results we can download the returned data.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"T58DLB3qou"}],"key":"XNgi214J4O"}],"visibility":"show","key":"RxzpVvir1X"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#select the first item in the result to download\nproduct = r.json()[\"features\"][0]\n\n# DownloadLink is an asset representing the whole product\ndownload_url = product[\"assets\"][\"downloadLink\"][\"href\"]\nITEM_ID = product[\"id\"]\n\nresponse = requests.get(download_url,stream=True,headers=auth_headers)\n\n# If the request was successful, download the file\nif (response.status_code == HTTP_SUCCESS_CODE):\n        print(\"Downloading ...\")\n        filename = ITEM_ID + \".zip\"\n        with open(filename, 'wb') as f:\n            for chunk in r.iter_content(chunk_size=1024): \n                if chunk:\n                    f.write(chunk)\n                    f.flush()\n        print(\"The dataset has been downloaded to: {}\".format(filename))\nelse: print(\"Request Unsuccessful! Error-Code: {}\".format(response.status_code))","key":"uxcNzU4Y6s"},{"type":"output","id":"ud41F1vjC8w7hWixH0Sue","data":[{"name":"stdout","output_type":"stream","text":"Downloading ...\nThe dataset has been downloaded to: S3A_OL_2_WRR____20240909T130929_20240909T135342_20240910T163350_2653_116_352______MAR_O_NT_003.zip\n"}],"key":"OpYt2loHRu"}],"key":"tX9HyRoTnn"}],"key":"wGHgFjT2lV"},"references":{"cite":{"order":[],"data":{}}}}